<style>
  .menu-root {
    width: 80;
    padding: 2.5;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #000000;
    border-color: #ffffff;
    border-width: 0.15;
    border-radius: 0;
  }

  .title {
    font-size: 3.2;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    margin-bottom: 2;
    font-family: hud;
  }

  .title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 2;
  }

  .title-k {
    font-size: 8.4;
    color: #ffffff;
    font-family: script;
  }

  .title-rest {
    font-size: 3.2;
    font-weight: bold;
    color: #ffffff;
    font-family: hud;
  }

  .page-main {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .page-achievements {
    display: none;
    flex-direction: column;
    align-items: stretch;
  }

  .page-settings {
    display: none;
    flex-direction: column;
    align-items: stretch;
  }

  /* Five side-by-side columns instead of one long stacked list — same
     content, roughly a fifth of the vertical run, so the achievements page
     (the tallest of this menu's three pages) reads as a compact page instead
     of one the player has to scroll/crane through. */
  .ach-list {
    display: flex;
    flex-direction: row;
    margin-top: 0.5;
    gap: 0.8;
  }

  .ach-col {
    display: flex;
    flex-direction: column;
    width: 19%;
  }

  .ach-row {
    display: flex;
    flex-direction: column;
    padding: 0.8;
    margin-top: 0.5;
    border-width: 0.08;
    border-color: #3f3f46;
    border-radius: 0;
  }

  .ach-title {
    font-size: 2;
    font-weight: bold;
    color: #fafafa;
    font-family: hud;
  }

  .ach-desc {
    font-size: 1.4;
    color: #a1a1aa;
    margin-top: 0.3;
  }

  .ach-status {
    font-size: 1.4;
    color: #71717a;
    margin-top: 0.3;
  }

  /* Shared "comets released" lines under the title (see StartMenuSystem's
     _refreshCommunityLines) — hidden until their data has loaded, and stay
     hidden if it never does. ASCII only: the hud font atlas has no middle
     dot, so separators are "|" and "-". */
  .community-lines {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .community {
    display: none;
    font-size: 1.8;
    color: #d4d4d8;
    margin-top: 0.4;
  }

  .community-sub {
    display: none;
    font-size: 1.5;
    color: #a1a1aa;
    margin-top: 0.4;
  }

  /* Reached from the Achievements page's Leaderboard cube, which itself
     only exists once leaderboard data has loaded (see StartMenuSystem). */
  .page-leaderboard {
    display: none;
    flex-direction: column;
    align-items: stretch;
  }

  .lb-row {
    display: none;
    flex-direction: row;
    align-items: center;
    padding: 0.6;
    margin-top: 0.4;
    border-width: 0.08;
    border-color: #3f3f46;
    border-radius: 0;
  }

  .lb-rank {
    width: 8;
    font-size: 1.8;
    color: #a1a1aa;
  }

  .lb-name {
    flex-grow: 1;
    font-size: 1.8;
    color: #fafafa;
  }

  .lb-value {
    font-size: 1.8;
    color: #fafafa;
  }

  .lb-me {
    display: none;
    font-size: 1.8;
    color: #4ade80;
    margin-top: 1;
  }

  .lb-hint {
    display: none;
    font-size: 1.4;
    color: #71717a;
    margin-top: 0.6;
  }
</style>
<div class="menu-root">
  <div id="page-main" class="page-main">
    <div class="title-row">
      <span class="title-k">K</span>
      <span class="title-rest">ometa</span>
    </div>
    <div class="community-lines">
      <span id="community-total" class="community">-</span>
      <span id="community-split" class="community-sub">-</span>
      <span id="community-me" class="community-sub">-</span>
    </div>
  </div>
  <div id="page-achievements" class="page-achievements">
    <hudtext class="title">Achievements</hudtext>
    <div class="ach-list">
      <div class="ach-col">
        <div class="ach-row">
          <hudtext class="ach-title">Stargazer</hudtext>
          <span class="ach-desc">Wander far enough from the comet to gather a distant speck of stardust.</span>
          <span id="ach-status-stargazer" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Far Side</hudtext>
          <span class="ach-desc">Seed the side of the planet facing directly away from where you started.</span>
          <span id="ach-status-far-side" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Second Thoughts</hudtext>
          <span class="ach-desc">Linger at both choice zones before finally committing to one.</span>
          <span id="ach-status-second-thoughts" class="ach-status">Locked</span>
        </div>
      </div>
      <div class="ach-col">
        <div class="ach-row">
          <hudtext class="ach-title">Full Sweep</hudtext>
          <span class="ach-desc">Clear every mote from all three Stardust swirls before the phase ends.</span>
          <span id="ach-status-full-sweep" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Ambidextrous</hudtext>
          <span class="ach-desc">Toss the comet to your other hand and catch it.</span>
          <span id="ach-status-ambidextrous" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">True Believer</hudtext>
          <span class="ach-desc">Finish Pebbles with one type making up 90% or more of what you gathered.</span>
          <span id="ach-status-true-believer" class="ach-status">Locked</span>
        </div>
      </div>
      <div class="ach-col">
        <div class="ach-row">
          <hudtext class="ach-title">Perfect Balance</hudtext>
          <span class="ach-desc">Finish Pebbles with all three types gathered in close to even measure.</span>
          <span id="ach-status-perfect-balance" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Soul Collector</hudtext>
          <span class="ach-desc">Gather every detached soul in the graveyard.</span>
          <span id="ach-status-soul-collector" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Green Thumb</hudtext>
          <span class="ach-desc">Gather every seed offered to you.</span>
          <span id="ach-status-green-thumb" class="ach-status">Locked</span>
        </div>
      </div>
      <div class="ach-col">
        <div class="ach-row">
          <hudtext class="ach-title">Faced the Mob</hudtext>
          <span class="ach-desc">Face every last member of the angry, grieving crowd.</span>
          <span id="ach-status-faced-the-mob" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Eternal Light</hudtext>
          <span class="ach-desc">Choose to orbit the planet forever.</span>
          <span id="ach-status-eternal-light" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Into the Unknown</hudtext>
          <span class="ach-desc">Choose to launch onward into the universe.</span>
          <span id="ach-status-into-the-unknown" class="ach-status">Locked</span>
        </div>
      </div>
      <div class="ach-col">
        <div class="ach-row">
          <hudtext class="ach-title">Indecisive</hudtext>
          <span class="ach-desc">Let the clock run out without choosing your comet's fate.</span>
          <span id="ach-status-indecisive" class="ach-status">Locked</span>
        </div>
        <div class="ach-row">
          <hudtext class="ach-title">Complete Collection</hudtext>
          <span class="ach-desc">Experience every combination of comet type and final choice.</span>
          <span id="ach-status-complete-collection" class="ach-status">Locked</span>
        </div>
      </div>
    </div>
  </div>
  <div id="page-leaderboard" class="page-leaderboard">
    <hudtext class="title">Most Comets Released</hudtext>
    <div id="lb-row-0" class="lb-row">
      <span id="lb-rank-0" class="lb-rank">-</span>
      <span id="lb-name-0" class="lb-name">-</span>
      <span id="lb-value-0" class="lb-value">-</span>
    </div>
    <div id="lb-row-1" class="lb-row">
      <span id="lb-rank-1" class="lb-rank">-</span>
      <span id="lb-name-1" class="lb-name">-</span>
      <span id="lb-value-1" class="lb-value">-</span>
    </div>
    <div id="lb-row-2" class="lb-row">
      <span id="lb-rank-2" class="lb-rank">-</span>
      <span id="lb-name-2" class="lb-name">-</span>
      <span id="lb-value-2" class="lb-value">-</span>
    </div>
    <div id="lb-row-3" class="lb-row">
      <span id="lb-rank-3" class="lb-rank">-</span>
      <span id="lb-name-3" class="lb-name">-</span>
      <span id="lb-value-3" class="lb-value">-</span>
    </div>
    <div id="lb-row-4" class="lb-row">
      <span id="lb-rank-4" class="lb-rank">-</span>
      <span id="lb-name-4" class="lb-name">-</span>
      <span id="lb-value-4" class="lb-value">-</span>
    </div>
    <div id="lb-row-5" class="lb-row">
      <span id="lb-rank-5" class="lb-rank">-</span>
      <span id="lb-name-5" class="lb-name">-</span>
      <span id="lb-value-5" class="lb-value">-</span>
    </div>
    <div id="lb-row-6" class="lb-row">
      <span id="lb-rank-6" class="lb-rank">-</span>
      <span id="lb-name-6" class="lb-name">-</span>
      <span id="lb-value-6" class="lb-value">-</span>
    </div>
    <div id="lb-row-7" class="lb-row">
      <span id="lb-rank-7" class="lb-rank">-</span>
      <span id="lb-name-7" class="lb-name">-</span>
      <span id="lb-value-7" class="lb-value">-</span>
    </div>
    <div id="lb-row-8" class="lb-row">
      <span id="lb-rank-8" class="lb-rank">-</span>
      <span id="lb-name-8" class="lb-name">-</span>
      <span id="lb-value-8" class="lb-value">-</span>
    </div>
    <div id="lb-row-9" class="lb-row">
      <span id="lb-rank-9" class="lb-rank">-</span>
      <span id="lb-name-9" class="lb-name">-</span>
      <span id="lb-value-9" class="lb-value">-</span>
    </div>
    <span id="lb-me" class="lb-me">-</span>
    <span id="lb-hint" class="lb-hint">Sign in on the Kometa page before entering VR to join.</span>
  </div>
  <div id="page-settings" class="page-settings">
    <hudtext class="title">Settings</hudtext>
  </div>
</div>
