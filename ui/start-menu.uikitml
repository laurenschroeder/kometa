<style>
  .menu-root {
    width: 55;
    padding: 2.5;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #09090b;
    border-color: #ffffff;
    border-width: 0.15;
    border-radius: 2;
  }

  .title {
    font-size: 3.2;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    margin-bottom: 2;
    font-family: hud;
  }

  .page-main {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .page-achievements {
    display: none;
    flex-direction: column;
    align-items: stretch;
  }

  .page-settings {
    display: none;
    flex-direction: column;
    align-items: stretch;
  }

  .start-hint {
    color: #ffffff;
    font-size: 2.2;
    text-align: center;
    font-family: hud;
    font-weight: bold;
    margin-top: 1.4;
    margin-bottom: 1.4;
  }

  .ach-list {
    display: flex;
    flex-direction: column;
    margin-top: 0.5;
  }

  .ach-row {
    display: flex;
    flex-direction: column;
    padding: 1;
    margin-top: 0.6;
    border-width: 0.08;
    border-color: #3f3f46;
    border-radius: 0.8;
  }

  .ach-title {
    font-size: 2;
    font-weight: bold;
    color: #fafafa;
    font-family: hud;
  }

  .ach-desc {
    font-size: 1.4;
    color: #a1a1aa;
    margin-top: 0.3;
  }

  .ach-status {
    font-size: 1.4;
    color: #71717a;
    margin-top: 0.3;
  }
</style>
<div class="menu-root">
  <div id="page-main" class="page-main">
    <hudtext class="title">Kometa</hudtext>
    <hudtext id="start-hint" class="start-hint">Pinch (or pull trigger) with both hands to start</hudtext>
  </div>
  <div id="page-achievements" class="page-achievements">
    <hudtext class="title">Achievements</hudtext>
    <div class="ach-list">
      <div class="ach-row">
        <hudtext class="ach-title">Full Sweep</hudtext>
        <span class="ach-desc">Clear every mote from all three Stardust swirls before the phase ends.</span>
        <span id="ach-status-full-sweep" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Ambidextrous</hudtext>
        <span class="ach-desc">Toss the comet to your other hand and catch it.</span>
        <span id="ach-status-ambidextrous" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">True Believer</hudtext>
        <span class="ach-desc">Finish Pebbles with one type making up 90% or more of what you gathered.</span>
        <span id="ach-status-true-believer" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Perfect Balance</hudtext>
        <span class="ach-desc">Finish Pebbles with all three types gathered in close to even measure.</span>
        <span id="ach-status-perfect-balance" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Soul Collector</hudtext>
        <span class="ach-desc">Gather every detached soul in the graveyard.</span>
        <span id="ach-status-soul-collector" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Green Thumb</hudtext>
        <span class="ach-desc">Gather every seed offered to you.</span>
        <span id="ach-status-green-thumb" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Faced the Mob</hudtext>
        <span class="ach-desc">Face every last member of the angry, grieving crowd.</span>
        <span id="ach-status-faced-the-mob" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Eternal Light</hudtext>
        <span class="ach-desc">Choose to orbit the planet forever.</span>
        <span id="ach-status-eternal-light" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Into the Unknown</hudtext>
        <span class="ach-desc">Choose to launch onward into the universe.</span>
        <span id="ach-status-into-the-unknown" class="ach-status">Locked</span>
      </div>
      <div class="ach-row">
        <hudtext class="ach-title">Complete Collection</hudtext>
        <span class="ach-desc">Experience every combination of comet type and final choice.</span>
        <span id="ach-status-complete-collection" class="ach-status">Locked</span>
      </div>
    </div>
  </div>
  <div id="page-settings" class="page-settings">
    <hudtext class="title">Settings</hudtext>
  </div>
</div>
