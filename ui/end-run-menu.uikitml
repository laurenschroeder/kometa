<style>
  .menu-root {
    width: 55;
    padding: 2.5;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #000000;
    border-color: #ffffff;
    border-width: 0.15;
    border-radius: 0;
  }

  .title {
    font-size: 2.6;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    margin-bottom: 2;
    font-family: hud;
  }

  /* Shared comet counter lines (see EndRunMenuSystem._fillCometLines) —
     hidden unless this run's release was actually recorded/loaded. */
  .comet-line {
    display: none;
    font-size: 2;
    color: #d4d4d8;
    margin-top: 0.4;
  }

  .comet-lines {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

</style>
<div class="menu-root">
  <hudtext class="title">Your time with the comet is done.</hudtext>
  <div class="comet-lines">
    <span id="end-run-comet" class="comet-line">-</span>
    <span id="end-run-split" class="comet-line">-</span>
  </div>
</div>
