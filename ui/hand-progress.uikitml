<style>
  .wrist-root {
    width: 32;
    padding: 1.2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #09090bcc;
    border-color: #ffffff;
    border-width: 0.1;
    border-radius: 1.4;
  }

  .wrist-label {
    font-size: 1.7;
    font-weight: bold;
    color: #fafafa;
    text-align: center;
    margin-bottom: 0.8;
    font-family: hud;
  }

  .bar-track {
    position-type: relative;
    width: 100%;
    height: 2.6;
    border-width: 0.08;
    border-color: #ffffff;
    border-radius: 0.7;
    overflow: hidden;
    background-color: #1c1c1f;
  }

  .bar-fill {
    position-type: absolute;
    position-left: 0;
    position-top: 0;
    position-bottom: 0;
    width: 0%;
    background-color: #4a9aff;
  }
</style>
<div class="wrist-root">
  <hudtext id="wrist-label" class="wrist-label">Stardust</hudtext>
  <div class="bar-track">
    <div id="wrist-bar-fill" class="bar-fill"></div>
  </div>
</div>
