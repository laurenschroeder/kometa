<style>
  .wrist-root {
    width: 32;
    padding: 1.2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #09090bcc;
    border-color: #ffffff;
    border-width: 0.1;
    border-radius: 1.4;
  }

  .label-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.8;
  }

  .phase-glyph {
    width: 0.9;
    height: 0.9;
    border-radius: 0.45;
    background-color: #fffae2;
    margin-right: 0.6;
  }

  .wrist-label {
    font-size: 1.7;
    font-weight: bold;
    color: #fafafa;
    text-align: center;
    font-family: hud;
  }

  .bar-track {
    position-type: relative;
    width: 100%;
    height: 2.6;
    border-width: 0.08;
    border-color: #ffffff;
    border-radius: 0.7;
    overflow: hidden;
    background-color: #1c1c1f;
  }

  .bar-sparkle {
    position-type: absolute;
    position-top: 1.1;
    width: 0.4;
    height: 0.4;
    border-radius: 0.2;
    background-color: #fffae2;
    opacity: 0;
  }

  .bar-sparkle-0 {
    position-left: 20%;
  }

  .bar-sparkle-1 {
    position-left: 50%;
  }

  .bar-sparkle-2 {
    position-left: 80%;
  }

  .bar-fill {
    position-type: absolute;
    position-left: 0;
    position-top: 0;
    position-bottom: 0;
    width: 0%;
    background-color: #4a9aff;
  }

  /* Pebbles-only: a stacked, multi-colored fill (soul/organic/gas) instead
     of the single-color bar-fill above — see HandProgressHudSystem's own
     comment on why. Same absolute overlay footprint as .bar-fill; each
     segment is a plain flex child so it only ever occupies its own share,
     leaving the rest of the track showing its normal dark background,
     exactly like the single bar's own unfilled remainder. */
  .bar-fill-pebbles {
    position-type: absolute;
    position-left: 0;
    position-top: 0;
    position-bottom: 0;
    width: 100%;
    display: flex;
    flex-direction: row;
  }

  .bar-seg {
    height: 100%;
    width: 0%;
  }

  .bar-seg-0 {
    background-color: #85aaff;
  }

  .bar-seg-1 {
    background-color: #caff81;
  }

  .bar-seg-2 {
    background-color: #ff7053;
  }
</style>
<div class="wrist-root">
  <div class="label-row">
    <div id="wrist-phase-glyph" class="phase-glyph"></div>
    <hudtext id="wrist-label" class="wrist-label">Stardust</hudtext>
  </div>
  <div id="wrist-bar-track" class="bar-track">
    <div id="wrist-bar-fill" class="bar-fill"></div>
    <div id="wrist-bar-fill-pebbles" class="bar-fill-pebbles">
      <div id="wrist-bar-seg-0" class="bar-seg bar-seg-0"></div>
      <div id="wrist-bar-seg-1" class="bar-seg bar-seg-1"></div>
      <div id="wrist-bar-seg-2" class="bar-seg bar-seg-2"></div>
    </div>
    <div id="wrist-sparkle-0" class="bar-sparkle bar-sparkle-0"></div>
    <div id="wrist-sparkle-1" class="bar-sparkle bar-sparkle-1"></div>
    <div id="wrist-sparkle-2" class="bar-sparkle bar-sparkle-2"></div>
  </div>
</div>
